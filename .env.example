# MedLens environment configuration
#
# MedLens runs FULLY OFFLINE by default: the deterministic extractor + engines
# need no keys, no network, no backend. The variables below are ONLY needed if
# you enable the optional live-LLM extractor for messy documents.
#
# SECURITY RULE: an LLM API key must NEVER be exposed to the browser. The live
# extractor therefore calls a BACKEND endpoint that holds the key server-side.
# Do not put a raw provider key in any VITE_* variable — those are bundled into
# client code and shipped to every visitor.

# DEMO_MODE (default true): true = the app makes ZERO network/API calls; all
# extraction runs in-browser with the deterministic engine. Set to "false" AND
# provide VITE_EXTRACTION_ENDPOINT below to enable the live-LLM path.
VITE_DEMO_MODE=true

# URL of your server-side extraction proxy (holds the provider key).
# Leave empty to keep MedLens fully deterministic/offline (default).
VITE_EXTRACTION_ENDPOINT=

# Model the backend proxy should use (informational; the backend enforces it).
VITE_EXTRACTION_MODEL=claude-sonnet-5

# ---- Server-side only (NOT prefixed with VITE_, never sent to the client) ----
# These belong to the backend proxy service, not this front-end.
# ANTHROPIC_API_KEY=sk-ant-...
